{
    "info": {
        "_postman_id": "c1a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c",
        "name": "Blacklist API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Ping",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/blacklists/ping",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "blacklists",
                        "ping"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Health",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"Health is ok\", () => pm.expect(pm.response.json().status).to.eql(\"healthy\"));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/health",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "health"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Create Blacklist",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "const timestamp = Date.now();",
                            "pm.collectionVariables.set(\"email\", `test${timestamp}@example.com`);"
                        ],
                        "type": "text/javascript"
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                            "// Validacion comentada porque la API no devuelve la propiedad 'email' en la raiz del JSON de respuesta.",
                            "// pm.test(\"Email matches\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"{{email}}\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"blocked_reason\": \"Spam detectado\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/blacklists",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "blacklists"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Check Blacklist",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                            "pm.test(\"Is blacklisted\", () => pm.expect(pm.response.json().is_blacklisted).to.be.true);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/blacklists/{{email}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "blacklists",
                        "{{email}}"
                    ]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "email",
            "value": ""
        }
    ]
}